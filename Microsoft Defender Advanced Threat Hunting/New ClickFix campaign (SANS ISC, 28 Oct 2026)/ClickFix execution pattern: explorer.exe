DeviceProcessEvents
| where Timestamp > ago(30d)
| where InitiatingProcessFileName in~ ("explorer.exe","WindowsTerminal.exe","wt.exe","OpenConsole.exe")
| where FileName in~ ("powershell.exe","pwsh.exe","mshta.exe","cmd.exe","curl.exe","msiexec.exe",
                      "rundll32.exe","regsvr32.exe","certutil.exe","bitsadmin.exe","wscript.exe","cscript.exe","conhost.exe")
| where ProcessCommandLine has_any ("http://","https://")
     or ProcessCommandLine has_any ("iex","invoke-expression","irm ","iwr ","downloadstring","frombase64string",
                                    " -enc"," -e ","-w hidden","-windowstyle hidden","-nop","bypass")
| where not(ProcessCommandLine has_any ("microsoft.com","windowsupdate.com"))   // tune for your environment
| project Timestamp, DeviceId, DeviceName, ReportId, AccountName, InitiatingProcessFileName,
          FileName, ProcessCommandLine
| order by Timestamp desc
